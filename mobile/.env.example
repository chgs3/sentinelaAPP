# Ambiente local. Valores aceitos: dev, beta ou prod.
APP_ENV=dev

# localhost funciona no iOS Simulator. Em aparelho físico, use o IP da sua
# máquina na rede (por exemplo, http://192.168.1.100:3333). No emulador Android,
# normalmente use http://10.0.2.2:3333.
EXPO_PUBLIC_API_URL=http://localhost:3333
