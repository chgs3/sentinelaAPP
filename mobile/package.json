{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env APP_ENV=dev expo start",
    "start:beta": "cross-env APP_ENV=beta expo start",
    "start:prod": "cross-env APP_ENV=prod expo start",
    "android": "expo run:android",
    "android:dev": "cross-env APP_ENV=dev expo run:android",
    "android:beta": "cross-env APP_ENV=beta expo run:android",
    "android:prod": "cross-env APP_ENV=prod expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test --test-isolation=none config/**/*.test.cjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "quality": "npm run test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.14.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
