# Aplicação
NODE_ENV=development
PORT=3333
APP_NAME=Sentinela

# Banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinela

# Use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=substitua-por-uma-chave-segura-de-32-caracteres

# Opcional: sem esta chave, o parser local continua funcionando.
GEMINI_API_KEY=

# Opcional: preencha todo o bloco para enviar chamados por e-mail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
