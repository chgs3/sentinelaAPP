# Aplicação
NODE_ENV=development
PORT=3333
APP_NAME=Sentinela

# Banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinela

# Use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=substitua-por-uma-chave-segura-de-32-caracteres

# Opcional: sem esta chave, o parser local continua funcionando.
GEMINI_API_KEY=

# Segurança HTTP
# Em produção, liste explicitamente as origens web separadas por vírgula.
# Aplicativos nativos sem cabeçalho Origin continuam permitidos.
CORS_ORIGINS=http://localhost:8081
JSON_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
# Use true quando a API estiver atrás de um proxy confiável, como Render.
TRUST_PROXY=false

# Opcional: preencha todo o bloco para enviar chamados por e-mail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
