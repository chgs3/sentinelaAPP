generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    Transaction[]
  debts           Debt[]
  monthlyClosures MonthlyClosure[]
  supportTickets  SupportTicket[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  type          String
  amount        Float
  description   String
  category      String
  transactionAt DateTime
  paymentMethod String?
  accountOrCard String?
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Debt {
  id          Int      @id @default(autoincrement())
  personName  String
  type        String
  amount      Float
  description String
  status      String
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlyClosure {
  id                Int      @id @default(autoincrement())
  month             Int
  year              Int
  startDate         DateTime
  endDate           DateTime
  totalIncomes      Float
  totalExpenses     Float
  balance           Float
  totalTransactions Int
  closedAt          DateTime @default(now())
  userId            Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model SupportTicket {
  id                 Int      @id @default(autoincrement())
  category           String
  subject            String
  message            String
  appVersion         String?
  platform           String?
  deviceModel        String?
  osVersion          String?
  attachmentBase64   String?
  attachmentMimeType String?
  attachmentFileName String?
  status             String   @default("open")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}